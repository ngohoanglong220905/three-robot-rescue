<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="camera" params="suffix parent xyz rpy prefix">

    <link name="camera_link_${suffix}">
      <visual>
        <geometry>
          <mesh filename="package://ros2_omni_robot_sim/meshes/3w_v2/camera.stl" />
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1" />
        </material>
      </visual>

      <collision>
        <geometry>
          <mesh filename="package://ros2_omni_robot_sim/meshes/3w_v2/camera.stl" />
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5" />
        <inertia
          ixx="0.005"
          ixy="0"
          ixz="0"
          iyy="0.005"
          iyz="0"
          izz="0.005" />
      </inertial>
    </link>

    <joint name="camera_joint_${suffix}" type="fixed">
      <parent link="${parent}" />
      <child link="camera_link_${suffix}" />
      <origin xyz="${xyz}" rpy="${rpy}" />
      <axis xyz="0 0 1"/>
    </joint>

    <!-- The multi-robot planner does not consume RGB or depth images.
         Keep the camera mesh for appearance, but omit both GPU image sensors
         so three robots do not exhaust Ogre2 texture memory. -->
  </xacro:macro>

</robot>
