<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="imu" params="suffix parent xyz rpy prefix">

    <!-- IMU joint -->
    <joint
      name="${prefix}/imu_joint_${suffix}"
      type="fixed">

      <parent link="${parent}" />

      <child link="${prefix}/imu_link_${suffix}" />

      <origin
        xyz="${xyz}"
        rpy="${rpy}" />

    </joint>


    <!-- IMU link -->
    <link name="${prefix}/imu_link_${suffix}">

      <inertial>

        <origin xyz="0 0 0" />

        <mass value="0.005" />

        <inertia
          ixx="1.67e-8"
          ixy="0"
          ixz="0"
          iyy="1.67e-8"
          iyz="0"
          izz="1.67e-8" />

      </inertial>

    </link>


    <!-- Gazebo IMU -->
    <gazebo reference="${prefix}/imu_link_${suffix}">

      <sensor
        type="imu"
        name="${prefix}_imu_sensor">

        <topic>/${prefix}/imu</topic>

        <update_rate>50</update_rate>

        <always_on>1</always_on>

        <visualize>1</visualize>

      </sensor>

    </gazebo>

  </xacro:macro>

</robot>