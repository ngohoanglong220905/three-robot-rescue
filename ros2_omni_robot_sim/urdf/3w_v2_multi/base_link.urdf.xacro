<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Include -->
  <xacro:include filename="$(find ros2_omni_robot_sim)/urdf/3w_v2_multi/omni_wheel.urdf.xacro"/>
  <xacro:include filename="$(find ros2_omni_robot_sim)/urdf/3w_v2_multi/camera.urdf.xacro"/>
  <xacro:include filename="$(find ros2_omni_robot_sim)/urdf/3w_v2_multi/lidar.urdf.xacro"/>
  <xacro:include filename="$(find ros2_omni_robot_sim)/urdf/3w_v2_multi/imu.urdf.xacro"/>

  <xacro:macro
      name="base_link"
      params="parent xyz rpy prefix">

    <!-- ==================== BASE ==================== -->

    <link name="base_link">

      <visual>
        <geometry>
          <mesh filename="package://ros2_omni_robot_sim/meshes/3w_v2/base_link.dae" />
        </geometry>
      </visual>

      <collision>
        <geometry>
          <mesh filename="package://ros2_omni_robot_sim/meshes/3w_v2/base_link.stl" />
        </geometry>
      </collision>

      <inertial>
        <mass value="3.0" />
        <inertia
          ixx="0.9"
          ixy="0.0"
          ixz="0.0"
          iyy="0.9"
          iyz="0.0"
          izz="0.01"/>
      </inertial>

    </link>


    <!-- ==================== BASE JOINT ==================== -->

    <joint name="base_joint" type="fixed">

      <parent link="${parent}" />
      <child link="base_link" />

      <origin
        xyz="${xyz}"
        rpy="${rpy}" />

    </joint>


    <!-- ==================== 3 OMNI WHEELS ==================== -->

    <xacro:omni_wheel
        parent="base_link"
        suffix="1"
        xyz="0.0927 0.0000 0.0145"
        rpy="-0.8040 1.5708 -0.8040"/>

    <xacro:omni_wheel
        parent="base_link"
        suffix="2"
        xyz="-0.0464 0.0803 0.0145"
        rpy="-0.8040 1.5708 1.290"/>

    <xacro:omni_wheel
        parent="base_link"
        suffix="3"
        xyz="-0.0464 -0.0803 0.0145"
        rpy="-0.8040 1.5708 -2.8984"/>


    <!-- ==================== CAMERA ==================== -->

    <xacro:camera
        parent="base_link"
        suffix="1"
        xyz="0.1035 -0.0000 0.0630"
        rpy="0 0 0"
        prefix="${prefix}"/>


    <!-- ==================== LIDAR ==================== -->

    <xacro:lidar
        parent="base_link"
        suffix="1"
        xyz="0.0000 0.0000 0.1010"
        rpy="0 0 0"
        prefix="${prefix}"/>


    <!-- ==================== IMU ==================== -->

    <xacro:imu
        parent="base_link"
        suffix="1"
        xyz="0 0 0"
        rpy="0 0 0"
        prefix="${prefix}"/>

  </xacro:macro>

</robot>